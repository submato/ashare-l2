# Base URL of the A-share L2 API (leave empty to use local reader only)
ASHARE_L2_BASE_URL=https://api.example.com/v1

# API key for authenticated access
ASHARE_L2_API_KEY=your_api_key_here

# Optional: local day-folder root for offline CSV layout
#   {ASHARE_L2_DATA_ROOT}/{SYMBOL}/l2/YYYYMMDD/{行情,逐笔委托,逐笔成交}.csv
ASHARE_L2_DATA_ROOT=/path/to/stockdata
